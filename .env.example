# Copiez vers .env
PORT=3000

# --- PostgreSQL (connexion directe via pg) ---
# URI interne / privée (ne forcez pas SSL côté app)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# CORS (origines autorisées, séparées par des virgules)
# FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# CMI Payment Gateway
CMI_CLIENT_ID=7700147718
CMI_STORE_KEY=
CMI_PAYMENT_URL=https://testpayment.cmi.co.ma/fim/est3Dgate
CMI_OK_URL=http://localhost:3001/payments/cmi/success
CMI_FAIL_URL=http://localhost:3001/payments/cmi/fail
CMI_CALLBACK_URL=http://localhost:3001/payments/cmi/callback

# Créer les tables : exécuter dans SQL Editor / psql
#   sql/supabase-admin-tables.sql
#   sql/supabase-reservations.sql
#   sql/supabase-rooms.sql

# --- Upload images chambres (Cloudinary recommandé ; sinon disque ./uploads) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# URL publique de l’API (pour les URLs d’images en mode disque)
# PUBLIC_API_URL=http://localhost:3001

# Santé / DB :
# GET http://localhost:3000/health        → JSON (connected + message)
# GET http://localhost:3000/health/ui     → page navigateur + alert()
