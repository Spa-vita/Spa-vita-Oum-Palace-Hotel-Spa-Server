# Copiez vers .env
PORT=3000

# --- Supabase (API uniquement, pas de DATABASE_URL) ---
# URL du projet (souvent la même que NEXT_PUBLIC_SUPABASE_URL du front)
SUPABASE_URL=
# ou :
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Clé secrète serveur : Dashboard → Settings → API → service_role (ne jamais exposer au front)
SUPABASE_SERVICE_ROLE_KEY=

# Clé publishable / anon (front). Le backend peut l’utiliser si vous n’avez pas service_role,
# mais RLS bloquera souvent les écritures — préférez service_role pour Nest.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# SUPABASE_ANON_KEY=

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# CORS
# FRONTEND_ORIGIN=http://localhost:5173

# Créer les tables : exécuter sql/supabase-admin-tables.sql dans SQL Editor

# Santé / Supabase :
# GET http://localhost:3000/health        → JSON (connected + message)
# GET http://localhost:3000/health/ui     → page navigateur + alert()
